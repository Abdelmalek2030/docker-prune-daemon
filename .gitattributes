# Enforce Unix line endings across all text files for deterministic builds
* text=auto eol=lf

# Ensure Go source files are strictly counted by GitHub Linguist
*.go linguist-detectable=true

# Exclude Dockerfiles, installers, Makefiles, systemd units, and man pages from language statistics
Dockerfile linguist-vendored=true
Dockerfile.* linguist-vendored=true
Makefile linguist-vendored=true
*.sh linguist-vendored=true
*.service linguist-vendored=true
*.yml linguist-vendored=true
*.yaml linguist-vendored=true
*.json linguist-vendored=true
man/** linguist-documentation=true
docs/** linguist-documentation=true
*.md linguist-documentation=true
