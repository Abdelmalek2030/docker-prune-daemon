# Enforce Unix LF line endings across all source and configuration artifacts
* text=auto eol=lf
*.go text eol=lf
*.service text eol=lf
*.8 text eol=lf
Makefile text eol=lf

# Ensure GitHub Linguist classifies the repository as 100% Go
Makefile linguist-detectable=false
*.service linguist-detectable=false
.markdownlint.json linguist-detectable=false
man/* linguist-documentation=true
docs/* linguist-documentation=true

# Exclude CI and development metadata from release tarballs
.github/ export-ignore
docs/ export-ignore
.editorconfig export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.markdownlint.json export-ignore
